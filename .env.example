# API environment. Node: export variables, or use node --env-file=.env api/server.mjs.
# Docker Compose reads .env for substitution. Never commit the populated file.
PORT=8080
DATA_DIR=./api/data
TRUST_PROXY=0
RATE_LIMIT_PER_MIN=30

# Set both to enable administrator login. Generate independent random values:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
ROHA_ADMIN_TOKEN=
ROHA_ADMIN_ORIGIN=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Exact comma-separated origins/URLs. No wildcards. Empty disables extra hosts.
ROHA_EMBED_ORIGINS=
ROHA_AI_ENDPOINTS=http://localhost:11434/api/generate

# Production: use compose.production.yml, HTTPS origins, and a database URL.
# URL-encode special characters in passwords. In Compose the DB hostname is db.
ROHA_DEPLOYMENT=development
POSTGRES_PASSWORD=
DATABASE_URL=
# Example: postgresql://roha:URL_ENCODED_PASSWORD@db:5432/roha

# Provider keys/models are entered through /roha-admin.html, not browser env vars.
# Optional speech service (separate from typed AI interpretation):
ASR_URL=
ASR_KEY=
ASR_MODEL=whisper-1

# Offline maintenance only; supply through a protected operator environment.
# import: DATA_KEY is the destination key; SOURCE_DATA_KEY decrypts the source.
# rotate: OLD_DATA_KEY and NEW_DATA_KEY; install NEW_DATA_KEY as DATA_KEY after success.
# SOURCE_DATA_KEY=
# OLD_DATA_KEY=
# NEW_DATA_KEY=
# SCHEMA_DIR=./schema
